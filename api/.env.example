# Copiá este archivo a .env. Sin valores reales: los secretos, el índice y
# el modelo viven solo en .env, no en el código ni en este ejemplo.

# openai o gemini. Cualquier otro valor usa OpenAI, igual que app/llm.py.
LLM_PROVIDER=openai

OPENAI_API_KEY=
GOOGLE_API_KEY=

# app/llm.py no trae un nombre de modelo por defecto.
OPENAI_MODEL=
GEMINI_MODEL=

# Modelo local de embeddings. Si falta, la búsqueda sigue en BM25.
EMBEDDING_MODEL=

PINECONE_API_KEY=
INDEX_NAME=

# Cola de jobs y checkpoints de LangGraph. Redis 8 o Redis Stack.
REDIS_URL=redis://localhost:6379/0

# phoenix | langsmith | both
OBSERVABILIDAD=phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT=

# Solo si OBSERVABILIDAD es langsmith o both. No están en el mínimo de la
# fuente. app/observability.py ya las lee.
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=

JWT_SECRET=
SQLITE_PATH=

# Origen exacto del navegador, sin barra final y sin asterisco.
# Ejemplo local: http://localhost:5173
FRONTEND_ORIGIN=

# Cuántos grafos corren a la vez dentro del proceso.
WORKER_CONCURRENCY=4

# Tope diario en UTC. Si Redis no puede contar, la API deja pasar.
MAX_CARGAS_DIA=30
MAX_CONSULTAS_DIA=50
